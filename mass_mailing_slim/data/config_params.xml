<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Default configuration for mass_mailing_slim transforms.
        These only create ir.config_parameter rows; behaviour stays a no-op
        until tools/html_slim.py and the model overrides are implemented.
    -->
    <data noupdate="1">
        <record id="param_slim_enabled" model="ir.config_parameter">
            <field name="key">mass_mailing_slim.enabled</field>
            <field name="value">True</field>
        </record>
        <record id="param_slim_minify" model="ir.config_parameter">
            <field name="key">mass_mailing_slim.minify</field>
            <field name="value">True</field>
        </record>
        <record id="param_slim_fix_plaintext" model="ir.config_parameter">
            <field name="key">mass_mailing_slim.fix_plaintext</field>
            <field name="value">True</field>
        </record>
        <record id="param_slim_move_pixel" model="ir.config_parameter">
            <field name="key">mass_mailing_slim.move_pixel</field>
            <field name="value">True</field>
        </record>
        <record id="param_slim_strip_classes" model="ir.config_parameter">
            <field name="key">mass_mailing_slim.strip_classes</field>
            <field name="value">False</field>
        </record>
        <record id="param_slim_trim_defaults" model="ir.config_parameter">
            <field name="key">mass_mailing_slim.trim_defaults</field>
            <field name="value">False</field>
        </record>
        <record id="param_slim_normalize_css" model="ir.config_parameter">
            <field name="key">mass_mailing_slim.normalize_css</field>
            <field name="value">False</field>
        </record>
        <record id="param_slim_compress_shorthands" model="ir.config_parameter">
            <field name="key">mass_mailing_slim.compress_shorthands</field>
            <field name="value">False</field>
        </record>
        <record id="param_slim_minify_style_blocks" model="ir.config_parameter">
            <field name="key">mass_mailing_slim.minify_style_blocks</field>
            <field name="value">False</field>
        </record>
        <record id="param_slim_warn_kb" model="ir.config_parameter">
            <field name="key">mass_mailing_slim.warn_kb</field>
            <field name="value">100</field>
        </record>
        <record id="param_slim_class_allowlist" model="ir.config_parameter">
            <field name="key">mass_mailing_slim.class_allowlist</field>
            <field name="value">o_layout,o_mail_snippet_general</field>
        </record>
    </data>
</odoo>
