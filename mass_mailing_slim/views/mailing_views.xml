<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mailing_mailing_view_form_slim" model="ir.ui.view">
        <field name="name">mailing.mailing.form.slim.warning</field>
        <field name="model">mailing.mailing</field>
        <field name="inherit_id" ref="mass_mailing.view_mail_mass_mailing_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form[hasclass('o_mass_mailing_mailing_form')]/header" position="after">
                <div class="alert alert-warning" role="alert" invisible="not email_size_warning">
                    <field name="email_size_warning" invisible="1"/>
                    <i class="fa fa-exclamation-triangle me-1" role="img" aria-label="Warning" title="Warning"/>
                    <span>This email is about </span>
                    <field name="email_size_kb" class="oe_inline" readonly="1"/>
                    <span> KB. Gmail clips messages over ~102 KB, hiding content and breaking open tracking. Consider removing snippets or heavy images.</span>
                </div>
            </xpath>
            <xpath expr="//form[hasclass('o_mass_mailing_mailing_form')]/header/button[@name='action_test']" position="after">
                <button name="action_mass_mailing_slim_diagnose"
                        type="object"
                        string="Diagnose size"
                        class="btn-secondary"
                        help="Show where bytes are spent in this mailing's HTML."
                        invisible="not email_size_warning"/>
            </xpath>
        </field>
    </record>
</odoo>
