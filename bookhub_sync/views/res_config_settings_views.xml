<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bookhub_sync</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <block title="BookHub Sync" name="bookhub_sync_setting_container">
                    <setting string="CirclePOS API"
                             help="Credentials for the CirclePOS shadow site (bco.circlepos.com). Find the OAuth app under Settings &gt; Internal Services in the Circle backoffice.">
                        <field name="bookhub_base_url"/>
                        <field name="bookhub_site_domain"/>
                        <field name="bookhub_client_id"/>
                        <field name="bookhub_client_secret" password="True"/>
                    </setting>
                    <setting string="Sync">
                        <button name="action_bookhub_view_queue"
                                string="View Sync Queue"
                                type="object"
                                class="btn-link"/>
                        <button name="action_bookhub_full_sync"
                                string="Queue Full Sync"
                                type="object"
                                class="btn-link"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
