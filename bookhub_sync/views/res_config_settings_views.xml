<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bookhub_sync</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="inside">
                <setting string="BookHub Sync (CirclePOS)" id="bookhub_sync_setting"
                         help="Push product and stock updates to the CirclePOS shadow site. Find the OAuth app under Settings &gt; Internal Services in the Circle backoffice.">
                    <div class="content-group">
                        <div class="mt16 row">
                            <label for="bookhub_base_url" class="col-3 o_light_label"/>
                            <field name="bookhub_base_url"/>
                        </div>
                        <div class="mt16 row">
                            <label for="bookhub_site_domain" class="col-3 o_light_label"/>
                            <field name="bookhub_site_domain"/>
                        </div>
                        <div class="mt16 row">
                            <label for="bookhub_client_id" class="col-3 o_light_label"/>
                            <field name="bookhub_client_id"/>
                        </div>
                        <div class="mt16 row">
                            <label for="bookhub_client_secret" class="col-3 o_light_label"/>
                            <field name="bookhub_client_secret" password="True"/>
                        </div>
                    </div>
                    <div class="content-group mt16">
                        <button name="action_bookhub_view_queue"
                                string="View Sync Queue"
                                type="object"
                                icon="oi-arrow-right"
                                class="btn-link"/>
                        <button name="action_bookhub_full_sync"
                                string="Queue Full Sync"
                                type="object"
                                icon="oi-arrow-right"
                                class="btn-link"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
