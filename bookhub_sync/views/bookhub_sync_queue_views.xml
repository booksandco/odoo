<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="bookhub_sync_queue_view_list" model="ir.ui.view">
        <field name="name">bookhub.sync.queue.list</field>
        <field name="model">bookhub.sync.queue</field>
        <field name="arch" type="xml">
            <list>
                <field name="id"/>
                <field name="event"/>
                <field name="barcode"/>
                <field name="product_tmpl_id"/>
                <field name="state" decoration-danger="state == 'failed'"
                       decoration-muted="state == 'done'"/>
                <field name="attempts"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>

    <record id="bookhub_sync_queue_view_form" model="ir.ui.view">
        <field name="name">bookhub.sync.queue.form</field>
        <field name="model">bookhub.sync.queue</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="event"/>
                    <field name="state"/>
                    <field name="barcode"/>
                    <field name="product_tmpl_id"/>
                    <field name="attempts"/>
                </group>
                <group string="Payload">
                    <field name="payload" nolabel="1"/>
                </group>
                <group string="Error" invisible="not error">
                    <field name="error" nolabel="1" readonly="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="bookhub_sync_queue_action" model="ir.actions.act_window">
        <field name="name">BookHub Sync Queue</field>
        <field name="res_model">bookhub.sync.queue</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
