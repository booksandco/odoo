<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_product_reviews" inherit_id="website_sale.product_title" name="Hardcover Rating">
        <xpath expr="//div[@t-field='product.description_ecommerce']" position="after">
            <t t-if="product.x_hardcover_rating">
                <div class="o_shop_hardcover_rating d-flex align-items-center gap-2 mt-2">
                    <t t-call="portal_rating.rating_widget_stars_static">
                        <t t-set="rating_avg" t-value="product.x_hardcover_rating or 0.0"/>
                        <t t-set="rating_count" t-value="'%s ratings' % (product.x_hardcover_ratings_count or 0)"/>
                    </t>
                    <t t-if="product.x_hardcover_rating">
                        <span class="fw-bold" t-esc="round(product.x_hardcover_rating * 100) / 100"/>
                        <span class="text-muted">/ 5</span>
                    </t>
                    <a t-attf-href="https://hardcover.app/edition/isbn/#{product.barcode}/book" target="_blank" class="text-muted ms-1" title="View on Hardcover" aria-label="View on Hardcover">
                        <i class="fa fa-external-link"/>
                    </a>
                </div>
            </t>
        </xpath>
    </template>

    <template id="website_product_meta" inherit_id="website_sale.product_title" name="Bookstore Product Meta">
        <xpath expr="//h1[@t-field='product.name']" position="after">
            <div class="o_bookstore_meta text-muted small mb-2">
                <t t-if="product.author_line_ids">
                    By
                    <t t-foreach="product.author_line_ids.sorted('sequence')" t-as="line">
                        <t t-set="author_slug" t-value="request.env['ir.http']._slug(line.author_id)"/>
                        <a t-att-href="'/shop/author/%s' % author_slug" t-field="line.author_id.name"/>
                        <t t-if="not line_last">, </t>
                    </t>
                </t>
                <t t-if="product.x_publisher_id">
                    <t t-if="product.author_line_ids"> · </t>
                    <t t-set="publisher_slug" t-value="request.env['ir.http']._slug(product.x_publisher_id)"/>
                    <a t-att-href="'/shop/publisher/%s' % publisher_slug" t-field="product.x_publisher_id.name"/>
                </t>
                <t t-if="product.x_is_isbn">
                    <t t-if="product.author_line_ids or product.x_publisher_id"> · </t>
                    ISBN <span t-esc="product.barcode"/>
                </t>
                <t t-if="product.x_publication_date">
                    <t t-if="product.author_line_ids or product.x_publisher_id or product.x_is_isbn"> · </t>
                    <span t-field="product.x_publication_date"/>
                </t>
            </div>
        </xpath>
    </template>

    <template id="website_product_other_editions" inherit_id="website_sale.product" name="Bookstore Other Editions">
        <xpath expr="//div[hasclass('o_wsale_product_details_content_section_cta')]" position="after">
            <div t-if="other_editions" class="o_bookstore_other_editions border-top mt-4 pt-3">
                <h3 class="h5 mb-3">Other editions</h3>
                <div class="row g-2">
                    <t t-foreach="other_editions" t-as="edition">
                        <div class="col-6 col-md-4 col-lg-3">
                            <a t-att-href="edition.website_url" class="text-decoration-none">
                                <div class="card h-100">
                                    <div class="card-body p-2">
                                        <div t-field="edition.image_1920" t-options="{'widget': 'image', 'preview_image': 'image_256', 'class': 'card-img-top mb-2'}"/>
                                        <h6 class="card-title small mb-0" t-field="edition.name"/>
                                        <div class="d-flex justify-content-between align-items-center mt-2 small">
                                            <span class="fw-bold" t-field="edition.list_price"/>
                                            <span class="text-muted" t-esc="'Stock: %s' % round(edition.sudo().qty_available)"/>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </t>
                </div>
            </div>
        </xpath>
    </template>

    <template id="website_sale_products_item_hardcover_rating" inherit_id="website_sale.products_item" name="Hardcover Rating on Product Card">
        <xpath expr="//h2[hasclass('o_wsale_products_item_title', 'text-break')]" position="after">
            <t t-if="product.x_hardcover_rating">
                <div class="o_wsale_hardcover_rating text-muted small mb-1">
                    <t t-esc="round(product.x_hardcover_rating * 10) / 10"/>
                    <span>⭐</span>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
