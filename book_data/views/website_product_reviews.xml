<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_product_reviews" inherit_id="website_sale.product" name="Hardcover Reviews">
        <xpath expr="//div[@t-field='product.website_description']" position="after">
            <t t-if="product.x_hardcover_rating or product.x_hardcover_reviews_json">
                <div class="o_shop_hardcover_reviews border-top mt-4 pt-4" data-anchor="true">
                    <section id="o_hardcover_reviews" class="container pb48">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <img src="/book_data/static/src/img/hardcover_logo.png" alt="Hardcover" style="height:28px;"/>
                            <h2 class="fs-4 mb-0">Reviews</h2>
                        </div>

                        <!-- Rating Summary -->
                        <div class="d-flex align-items-center mb-3">
                            <t t-call="portal_rating.rating_widget_stars_static">
                                <t t-set="rating_avg" t-value="product.x_hardcover_rating or 0.0"/>
                                <t t-set="rating_count" t-value="'%s ratings' % (product.x_hardcover_ratings_count or 0)"/>
                            </t>
                            <t t-if="product.x_hardcover_rating">
                                <span class="ms-2 fw-bold" t-esc="round(product.x_hardcover_rating * 100) / 100"/>
                                <span class="text-muted ms-1">/ 5</span>
                            </t>
                        </div>

                        <!-- Top 5 Reviews -->
                        <t t-set="reviews" t-value="product.get_hardcover_reviews()"/>
                        <t t-if="reviews">
                            <div class="row g-3">
                                <t t-foreach="reviews" t-as="review">
                                    <div class="col-12">
                                        <div class="card">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <div class="d-flex align-items-center">
                                                        <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width:32px;height:32px;font-size:14px;">
                                                            <t t-esc="(review.get('username') or 'A')[0].upper()"/>
                                                        </div>
                                                        <span class="fw-bold" t-esc="review.get('username') or 'Anonymous'"/>
                                                    </div>
                                                    <t t-if="review.get('rating')">
                                                        <t t-set="r_val" t-value="float(review.get('rating'))"/>
                                                        <t t-set="r_int" t-value="int(r_val)"/>
                                                        <t t-set="r_dec" t-value="round(r_val % 1, 1)"/>
                                                        <t t-set="r_empty" t-value="5 - (r_int + 1) if r_dec else 5 - r_int"/>
                                                        <div class="o_website_rating_static">
                                                            <t t-foreach="range(0, r_int)" t-as="num">
                                                                <i class="fa fa-star" role="img"/>
                                                            </t>
                                                            <t t-if="r_dec">
                                                                <i class="fa fa-star-half-o" role="img"/>
                                                            </t>
                                                            <t t-foreach="range(0, r_empty)" t-as="num">
                                                                <i class="fa fa-star-o" role="img"/>
                                                            </t>
                                                        </div>
                                                    </t>
                                                </div>
                                                <p class="card-text text-muted mb-1" t-esc="review.get('review_raw')"/>
                                                <small class="text-muted">
                                                    <t t-if="review.get('reviewed_at')">
                                                        <t t-esc="review.get('reviewed_at')[:10]"/>
                                                    </t>
                                                    <t t-if="review.get('likes_count')">
                                                        <span class="ms-2">
                                                            <i class="fa fa-heart text-danger"/> <t t-esc="review.get('likes_count')"/>
                                                        </span>
                                                    </t>
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>

                        <!-- See More Button -->
                        <div class="mt-4 text-center">
                            <a t-attf-href="https://hardcover.app/edition/isbn/#{product.barcode}/book" target="_blank" class="btn btn-outline-primary d-inline-flex align-items-center gap-2">
                                <span>See more on</span>
                                <img src="/book_data/static/src/img/hardcover_logo.png" alt="Hardcover" style="height:18px;"/>
                                <i class="fa fa-external-link ms-1"/>
                            </a>
                        </div>
                    </section>
                </div>
            </t>
        </xpath>
    </template>

    <template id="website_product_meta" inherit_id="website_sale.product" name="Bookstore Product Meta">
        <xpath expr="//h1[@t-field='product.name']" position="after">
            <div class="o_bookstore_meta text-muted small mb-2">
                <t t-if="product.author_line_ids">
                    By
                    <t t-foreach="product.author_line_ids.sorted('sequence')" t-as="line">
                        <a t-attf-href="/shop/author/{{request.env['ir.http']._slug(line.author_id)}" t-field="line.author_id.name"/>
                        <t t-if="not line_last">, </t>
                    </t>
                </t>
                <t t-if="product.x_publisher_id">
                    <t t-if="product.author_line_ids"> · </t>
                    <a t-attf-href="/shop/publisher/{{request.env['ir.http']._slug(product.x_publisher_id)}" t-field="product.x_publisher_id.name"/>
                </t>
            </div>
        </xpath>
        <xpath expr="//div[@t-field='product.description_ecommerce']" position="after">
            <div t-if="other_editions" class="o_bookstore_other_editions border-top mt-4 pt-3">
                <h3 class="h5 mb-3">Other editions</h3>
                <div class="row g-2">
                    <t t-foreach="other_editions" t-as="edition">
                        <div class="col-6 col-md-4 col-lg-3">
                            <a t-att-href="edition.website_url" class="text-decoration-none">
                                <div class="card h-100">
                                    <div class="card-body p-2">
                                        <div t-field="edition.image_1920" t-options="{'widget': 'image', 'preview_image': 'image_256', 'class': 'card-img-top mb-2'}"/>
                                        <h6 class="card-title small mb-0" t-field="edition.name"/>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </t>
                </div>
            </div>
        </xpath>
    </template>

    <template id="website_sale_products_item_hardcover_rating" inherit_id="website_sale.products_item" name="Hardcover Rating on Product Card">
        <xpath expr="//h2[@class='o_wsale_products_item_title text-break']" position="after">
            <t t-if="product.x_hardcover_rating">
                <div class="o_wsale_hardcover_rating text-muted small mb-1">
                    <t t-esc="round(product.x_hardcover_rating * 10) / 10"/>
                    <span>⭐</span>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
