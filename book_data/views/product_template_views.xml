<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_form_view_book_data" model="ir.ui.view">
        <field name="name">product.template.form.book_data</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="before">
                <header>
                    <field name="x_is_isbn" invisible="1"/>
                    <button name="action_refresh_book_data"
                            type="object"
                            string="Refresh Book Data"
                            class="oe_highlight"
                            invisible="not x_is_isbn"/>
                    <button name="action_refresh_hardcover_data"
                            type="object"
                            string="Refresh Hardcover Data"
                            invisible="not x_is_isbn"/>
                    <button name="action_view_on_hardcover"
                            type="object"
                            string="View on Hardcover"
                            class="btn-secondary"
                            invisible="not x_is_isbn"/>
                </header>
            </xpath>
        </field>
    </record>
    <record id="product_template_form_view_book_data_score" model="ir.ui.view">
        <field name="name">product.template.form.book_data.score</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='image_1920']" position="replace">
                <div class="oe_avatar d-flex flex-column align-items-center">
                    <field name="image_1920" widget="image"
                        options="{'convert_to_webp': True, 'preview_image': 'image_128'}"/>
                    <span class="mt-1">Data Score: <field name="x_data_score_display" class="d-inline" readonly="1"/></span>
                </div>
            </xpath>
        </field>
    </record>
    <record id="product_template_tree_view_book_data_score" model="ir.ui.view">
        <field name="name">product.template.tree.book_data.score</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="x_data_score" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="product_template_form_view_book_data_barcode" model="ir.ui.view">
        <field name="name">product.template.form.book_data.barcode</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="bookstore.product_template_product_form_customization_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="replace">
                <field name="barcode" string="ISBN" invisible="not x_is_isbn"/>
                <field name="barcode" string="Barcode" invisible="x_is_isbn"/>
            </xpath>
        </field>
    </record>
    <record id="product_template_form_view_book_data_reviews" model="ir.ui.view">
        <field name="name">product.template.form.book_data.reviews</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="bookstore.product_template_product_form_customization_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="inside">
                <group string="Hardcover Reviews" invisible="not x_is_isbn">
                    <field name="x_hardcover_rating"/>
                    <field name="x_hardcover_ratings_count"/>
                    <field name="x_hardcover_reviews_count"/>
                    <field name="x_hardcover_reviews_fetch_date"/>
                    <field name="x_hardcover_reviews_json" widget="ace" options="{'mode': 'json'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
