<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sequence -->
    <record id="seq_vendor_return_order" model="ir.sequence">
        <field name="name">Vendor Return Order</field>
        <field name="code">vendor.return.order</field>
        <field name="prefix">VR/</field>
        <field name="padding">5</field>
    </record>

    <!-- Form View -->
    <record id="vendor_return_order_form" model="ir.ui.view">
        <field name="name">vendor.return.order.form</field>
        <field name="model">vendor.return.order</field>
        <field name="arch" type="xml">
            <form string="Vendor Return Order">
                <header>
                    <button name="action_send" type="object" string="Send to Vendor"
                        class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object" string="Confirm"
                        class="btn-primary" invisible="state != 'sent'"/>
                    <button name="action_generate_picks" type="object" string="Generate Picks"
                        class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_create_invoice" type="object" string="Create Credit Note"
                        invisible="state not in ('confirmed', 'done')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                        invisible="state not in ('draft', 'sent', 'confirmed')"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                        invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_picking" type="object"
                            class="oe_stat_button" icon="fa-truck"
                            invisible="picking_count == 0">
                            <field name="picking_count" widget="statinfo" string="Transfers"/>
                        </button>
                        <button name="action_view_invoice" type="object"
                            class="oe_stat_button" icon="fa-pencil-square-o"
                            invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo" string="Credit Notes"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date_order"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines" name="order_lines">
                            <field name="order_line">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="product_qty"/>
                                    <field name="price_unit"/>
                                    <field name="product_uom"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Add internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="vendor_return_order_list" model="ir.ui.view">
        <field name="name">vendor.return.order.list</field>
        <field name="model">vendor.return.order</field>
        <field name="arch" type="xml">
            <list string="Vendor Return Orders">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_order"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'sent'"
                    decoration-success="state in ('confirmed', 'done')"
                    decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="vendor_return_order_search" model="ir.ui.view">
        <field name="name">vendor.return.order.search</field>
        <field name="model">vendor.return.order</field>
        <field name="arch" type="xml">
            <search string="Search Vendor Returns">
                <field name="name"/>
                <field name="partner_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Sent" name="filter_sent" domain="[('state', '=', 'sent')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]"/>
                <filter string="Cancelled" name="filter_cancel" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <group>
                    <filter string="Vendor" name="group_vendor" domain="[]" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_vendor_return_order" model="ir.actions.act_window">
        <field name="name">Vendor Returns</field>
        <field name="res_model">vendor.return.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="vendor_return_order_search"/>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_vendor_return_order"
        name="Returns"
        parent="purchase.menu_procurement_management"
        action="action_vendor_return_order"
        sequence="10"/>

</odoo>
